function main(workbook: ExcelScript.Workbook) {
    const srcSheet = workbook.getActiveWorksheet();
    const usedRange = srcSheet.getUsedRange();
    if (!usedRange) return;

    const values = usedRange.getValues() as (string | number)[][];
    const entries = [] as string[];
    let mes: string = "";

    let i = 0;
    let count_entry = 0;
    let count_source = 0;

    while (i < values.length) {
      const colA = String(values[i][0] ?? "");
      if (colA !== "COMMON" && colA !==""){
        entries.push(colA);
        count_entry++;
        if (count_source > 1) {
          mes += entries[entries.length - 2] + 'に' + count_source + '個のsourceがあります; '
        }
        count_source = 0;
      }
      const colB = String(values[i][1] ?? "");
      if (colB === "source") {
        count_source++;
      }

      i++;
    }
    if (mes ==="") {
      mes = "source複数はありません"
    }
    console.log(mes);

    const duplicates = entries.filter(
      (value, index) => entries.indexOf(value) !== index
    );
    if (duplicates.length > 0) {
      console.log(duplicates + 'のEntry nameが重複しています');
      srcSheet.getCell(0, 6).setValue(duplicates + 'のEntry nameが重複しています; ' + mes);
    } else {
      console.log("Entry name重複はありません");
      srcSheet.getCell(0, 6).setValue("Entry name重複はありません; " + mes);
    }

}
