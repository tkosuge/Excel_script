function main(workbook: ExcelScript.Workbook) {
    const sheet = workbook.getActiveWorksheet();
    const usedRange = sheet.getUsedRange();

    const rowCount = usedRange.getRowCount();
    // 第1列(0) ～ 第5列(4)
    const ann_range = sheet.getRangeByIndexes(0, 0, rowCount, 5);
    if (!ann_range) return;
    const values = ann_range.getValues() as (string | number | Date)[][];

    const entries = [] as string[];
    let sourceDict: Record<string, Record<string, string[]>> = {};
    // const qualSet = new Set<string>();

    // entry nameをとりだす
    let i = 0;
    while (i < values.length) {
        const colA = String(values[i][0] ?? "");
        if (colA !== "COMMON" && colA !== "") {
            entries.push(colA);
        }
        i++;
    }
    // sourceのクオリファイアを検出
    i = 0;
    let src_on = 0;
    while (i < values.length) {
      const colA = String(values[i][0] ?? "");

      if (colA !== "COMMON" && colA !== "") {
        if (!sourceDict[colA]) {
          sourceDict[colA] = {};
        }
      }

      while (i < values.length) {
        const colB = String(values[i][1] ?? "");
        if (colB === "source") {
          const colC = String(values[i][2] ?? "");
          if (!sourceDict[colA]['location']) {
            sourceDict[colA]['location'] = [];
          }
          sourceDict[colA]['location'].push(colC);         
          src_on = 1;
        }
        if (src_on == 1) {
          var q = String(values[i][3] ?? "");
          var v = String(values[i][4] ?? "");

          if (!sourceDict[colA][q]) {
            sourceDict[colA][q] = [];
          }
          sourceDict[colA][q].push(v);

          // qualSet.add(q);
        }
        // 次のB列に何か書かれていたらoff
        i++;
        if (i < values.length && String(values[i][1] ?? "") !== "") {
          src_on = 0;
        }
        // 次のA列に何か書かれていたらbreak
        if (i < values.length && String(values[i][0] ?? "") !== "") {
          src_on = 0;
          // qualSet.forEach(value => {
          //   console.log(value, sourceDict[colA]["organism"]);
          // });
          break;
        }
      }
    }

    // source以外のフィーチャーを格納
    let featureDict: Record<string, string[]> = {};
    i = 0;
    let currentEntry = "";
    let currentFeature = "";
    let currentLocation = "";
    let buffer: string[] = [];
    let feat_on = 0;
    while (i < values.length) {
      const colA = String(values[i][0] ?? "");
      // Entry 切り替え
      if (colA !== "" && colA !== "COMMON") {
        currentEntry = colA;
        if (!featureDict[currentEntry]) {
          featureDict[currentEntry] = [];
        }
        while (i < values.length) {
          var colB = String(values[i][1] ?? "");
          var colC = String(values[i][2] ?? "");
          var colD = String(values[i][3] ?? "");
          var colE = String(values[i][4] ?? "");

          if (colB !== "" && colB !== "source") {
            buffer.push(colB, colC, colD, colE);
            feat_on = 1;
          }
          if (colB === "" && feat_on === 1) {
            buffer.push(colD, colE);
          }
          i++;
          //次の行B列がフィーチャーor最終行の時に格納
          if (i < values.length && String(values[i][1] ?? "") !== "" && feat_on === 1) {
            featureDict[currentEntry].push(
              `${buffer.join("\t")}`
            );
            buffer = [];
            feat_on = 0;
          }
          if (i < values.length && String(values[i][0] ?? "") !== "") {
            buffer = [];
            feat_on = 0;
            break;
          }
          if (i === values.length && buffer.length > 0) {
            featureDict[currentEntry].push(
              `${buffer.join("\t")}`
            );
            buffer = [];
            feat_on = 0;
          }
        }
      } else {
        i++;
      }
    }

    // 表示、console.log(sourceDict);
    const entryCount = Object.keys(sourceDict).length;
    console.log(`Entry 数: ${entryCount}`);

    const outSheet = workbook.addWorksheet("anntbl");
    let offset = 2;
    // Array.from(qualSet).forEach((v, idx) => {
    //     outSheet.getCell(0, offset+1+idx).setValue(v);
    // });

    // Entry name表示
    outSheet.getCell(0, offset).setValue("Entry#");
    Array.from(entries).forEach((v, idx) => {
        outSheet.getCell(1+idx, offset).setValue(v);
    });

    //クオリファイアの最大使用数検出 
    const maxLengthByqualKey: Record<string, number> = {};
    for (const entry of Object.values(sourceDict)) {
      for (const [key, values] of Object.entries(entry)) {
        const len = values.length;

        if (maxLengthByqualKey[key] === undefined || len > maxLengthByqualKey[key]) {
          maxLengthByqualKey[key] = len;
        }
      }
    }
    console.log(maxLengthByqualKey);

    // Qualifier使用数サマリ
    outSheet.getCell(0, 0).setValue('Summary');
    let row = 1;
    for (const [k, v] of Object.entries(maxLengthByqualKey)) {
      outSheet.getCell(row, 0).setValue(`${k}: ${v}`);
      row++;
    }
    // Qualifier表示
    let col = offset + 1;
    for (const [k, v] of Object.entries(maxLengthByqualKey)) {
      for (let i =0; i<v; i++) {
        outSheet.getCell(0, col).setValue(k);
        col++;
      }
    }

    // フィーチャー中身を表示
    const outputData: (string | number | Date)[][] = [];
    let collectiondateCol: number | null = null;
    let isolateCol: number | null = null;
    // source
    entries.forEach(entryname => {
      const rowData: (string | number | Date)[] = [];
      for (const [k, v] of Object.entries(maxLengthByqualKey)) {
        // ★ collection_date の開始列を保存（最初の1回だけ）
        if (k === "collection_date" && collectiondateCol === null) {
          collectiondateCol = rowData.length;
        }

        const values = sourceDict[entryname][k] ?? []; 
        for (let i = 0; i < v; i++) {
          rowData.push(values[i] ?? "");
        }
      }
      // Feature
      rowData.push(featureDict[entryname][0] ?? "");

      outputData.push(rowData);
    });

    const startRow = 1;
    const startCol = offset + 1;
    outSheet
      .getRangeByIndexes(
        startRow,
        startCol,
        outputData.length,
        outputData[0].length
      )
      .setValues(outputData);

    // date列書式をdate形式に変更
    if (collectiondateCol !== null) {
      const startRow = 1;                 // データ開始行（0始まり）
      const rowCount = entries.length;    // データ行数

      const range = outSheet.getRangeByIndexes(
        startRow,
        collectiondateCol + startCol,
        rowCount,
        maxLengthByqualKey['collection_date']
      );
      range.setNumberFormatLocal("yyyy-mm-dd");
    }

    // 先頭行固定、アクティブにしておいてからでないとfreezeRowsでエラーになる
    let sheet_res = workbook.getWorksheet("anntbl");
    sheet_res.activate();
    let selectedSheet = workbook.getActiveWorksheet();
    selectedSheet.getFreezePanes().freezeRows(1);

}
