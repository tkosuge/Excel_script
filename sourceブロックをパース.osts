{"version":"0.3.0","body":"function main(workbook: ExcelScript.Workbook) {\n    const sheet = workbook.getActiveWorksheet();\n    const usedRange = sheet.getUsedRange();\n\n    const rowCount = usedRange.getRowCount();\n    // 第1列(0) ～ 第5列(4)\n    const ann_range = sheet.getRangeByIndexes(0, 0, rowCount, 5);\n    if (!range) return;\n    const values = ann_range.getValues() as (string | number | Date)[][];\n\n    const entries = [] as string[];\n    let sourceDict: Record<string, Record<string, string[]>> = {};\n    // const qualSet = new Set<string>();\n\n    // entry nameをとりだす\n    let i = 0;\n    while (i < values.length) {\n        const colA = String(values[i][0] ?? \"\");\n        if (colA !== \"COMMON\" && colA !== \"\") {\n            entries.push(colA);\n        }\n        i++;\n    }\n    // sourceのクオリファイアを検出\n    i = 0;\n    let src_on = 0;\n    while (i < values.length) {\n      const colA = String(values[i][0] ?? \"\");\n\n      if (colA !== \"COMMON\" && colA !== \"\") {\n        if (!sourceDict[colA]) {\n          sourceDict[colA] = {};\n        }\n      }\n\n      while (i < values.length) {\n        const colB = String(values[i][1] ?? \"\");\n        if (colB === \"source\") {\n          const colC = String(values[i][2] ?? \"\");\n          if (!sourceDict[colA]['location']) {\n            sourceDict[colA]['location'] = [];\n          }\n          sourceDict[colA]['location'].push(colC);         \n          src_on = 1;\n        }\n        if (src_on == 1) {\n          var q = String(values[i][3] ?? \"\");\n          var v = String(values[i][4] ?? \"\");\n\n          if (!sourceDict[colA][q]) {\n            sourceDict[colA][q] = [];\n          }\n          sourceDict[colA][q].push(v);\n\n          // qualSet.add(q);\n        }\n        // 次のB列に何か書かれていたらoff\n        i++;\n        if (i < values.length && String(values[i][1] ?? \"\") !== \"\") {\n          src_on = 0;\n        }\n        // 次のA列に何か書かれていたらbreak\n        if (i < values.length && String(values[i][0] ?? \"\") !== \"\") {\n          src_on = 0;\n          // qualSet.forEach(value => {\n          //   console.log(value, sourceDict[colA][\"organism\"]);\n          // });\n          break;\n        }\n      }\n    }\n\n    // source以外のフィーチャーを格納\n    let featureDict: Record<string, string[]> = {};\n    i = 0;\n    let currentEntry = \"\";\n    let currentFeature = \"\";\n    let currentLocation = \"\";\n    let buffer: string[] = [];\n    let feat_on = 0;\n    while (i < values.length) {\n      const colA = String(values[i][0] ?? \"\");\n      // Entry 切り替え\n      if (colA !== \"\" && colA !== \"COMMON\") {\n        currentEntry = colA;\n        if (!featureDict[currentEntry]) {\n          featureDict[currentEntry] = [];\n        }\n        while (i < values.length) {\n          var colB = String(values[i][1] ?? \"\");\n          var colC = String(values[i][2] ?? \"\");\n          var colD = String(values[i][3] ?? \"\");\n          var colE = String(values[i][4] ?? \"\");\n\n          if (colB !== \"\" && colB !== \"source\") {\n            buffer.push(colB, colC, colD, colE);\n            feat_on = 1;\n          }\n          if (colB === \"\" && feat_on === 1) {\n            buffer.push(colD, colE);\n          }\n          i++;\n          //次の行B列がフィーチャーor最終行の時に格納\n          if (i < values.length && String(values[i][1] ?? \"\") !== \"\" && feat_on === 1) {\n            featureDict[currentEntry].push(\n              `${buffer.join(\"\\t\")}`\n            );\n            buffer = [];\n            feat_on = 0;\n          }\n          if (i < values.length && String(values[i][0] ?? \"\") !== \"\") {\n            buffer = [];\n            feat_on = 0;\n            break;\n          }\n          if (i === values.length && buffer.length > 0) {\n            featureDict[currentEntry].push(\n              `${buffer.join(\"\\t\")}`\n            );\n            buffer = [];\n            feat_on = 0;\n          }\n        }\n      } else {\n        i++;\n      }\n    }\n\n    // 表示、console.log(sourceDict);\n    const entryCount = Object.keys(sourceDict).length;\n    console.log(`Entry 数: ${entryCount}`);\n\n    const outSheet = workbook.addWorksheet(\"anntbl\");\n    let offset = 2;\n    // Array.from(qualSet).forEach((v, idx) => {\n    //     outSheet.getCell(0, offset+1+idx).setValue(v);\n    // });\n\n    // Entry name表示\n    outSheet.getCell(0, offset).setValue(\"Entry#\");\n    Array.from(entries).forEach((v, idx) => {\n        outSheet.getCell(1+idx, offset).setValue(v);\n    });\n\n    //クオリファイアの最大使用数検出 \n    const maxLengthByqualKey: Record<string, number> = {};\n    for (const entry of Object.values(sourceDict)) {\n      for (const [key, values] of Object.entries(entry)) {\n        const len = values.length;\n\n        if (maxLengthByqualKey[key] === undefined || len > maxLengthByqualKey[key]) {\n          maxLengthByqualKey[key] = len;\n        }\n      }\n    }\n    console.log(maxLengthByqualKey);\n\n    // Qualifier使用数サマリ\n    outSheet.getCell(0, 0).setValue('Summary');\n    let row = 1;\n    for (const [k, v] of Object.entries(maxLengthByqualKey)) {\n      outSheet.getCell(row, 0).setValue(`${k}: ${v}`);\n      row++;\n    }\n    // Qualifier表示\n    let col = offset + 1;\n    for (const [k, v] of Object.entries(maxLengthByqualKey)) {\n      for (let i =0; i<v; i++) {\n        outSheet.getCell(0, col).setValue(k);\n        col++;\n      }\n    }\n\n    // フィーチャー中身を表示\n    const outputData: (string | number | Date)[][] = [];\n    let collectiondateCol: number | null = null;\n    let isolateCol: number | null = null;\n    // source\n    entries.forEach(entryname => {\n      const rowData: (string | number | Date)[] = [];\n      for (const [k, v] of Object.entries(maxLengthByqualKey)) {\n        // ★ collection_date の開始列を保存（最初の1回だけ）\n        if (k === \"collection_date\" && collectiondateCol === null) {\n          collectiondateCol = rowData.length;\n        }\n\n        const values = sourceDict[entryname][k] ?? []; \n        for (let i = 0; i < v; i++) {\n          rowData.push(values[i] ?? \"\");\n        }\n      }\n      // Feature\n      rowData.push(featureDict[entryname][0] ?? \"\");\n\n      outputData.push(rowData);\n    });\n\n    const startRow = 1;\n    const startCol = offset + 1;\n    outSheet\n      .getRangeByIndexes(\n        startRow,\n        startCol,\n        outputData.length,\n        outputData[0].length\n      )\n      .setValues(outputData);\n\n    // date列書式をdate形式に変更\n    if (collectiondateCol !== null) {\n      const startRow = 1;                 // データ開始行（0始まり）\n      const rowCount = entries.length;    // データ行数\n\n      const range = outSheet.getRangeByIndexes(\n        startRow,\n        collectiondateCol + startCol,\n        rowCount,\n        maxLengthByqualKey['collection_date']\n      );\n      range.setNumberFormatLocal(\"yyyy-mm-dd\");\n    }\n\n    // 先頭行固定、アクティブにしておいてからでないとfreezeRowsでエラーになる\n    let sheet_res = workbook.getWorksheet(\"anntbl\");\n    sheet_res.activate();\n    let selectedSheet = workbook.getActiveWorksheet();\n    selectedSheet.getFreezePanes().freezeRows(1);\n\n}\n","description":"","noCodeMetadata":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}